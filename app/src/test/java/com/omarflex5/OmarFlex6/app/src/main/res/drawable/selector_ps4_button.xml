<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Focused State: Solid Blue + White Border + Outer Glow -->
    <item android:state_focused="true">
        <layer-list>
            <!-- Outer Glow (White/Blue mix) -->
            <item android:left="-4dp" android:top="-4dp" android:right="-4dp" android:bottom="-4dp">
                <shape android:shape="rectangle">
                    <solid android:color="#40FFFFFF" /> <!-- Subtle white glow -->
                    <corners android:radius="8dp" />
                </shape>
            </item>
            
            <!-- Main Button Background -->
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/ps4_blue" />
                    <corners android:radius="4dp" />
                </shape>
            </item>
            
            <!-- White Focus Border (inside) -->
            <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="2dp">
                <shape android:shape="rectangle">
                    <stroke android:width="3dp" android:color="#FFFFFF" />
                    <corners android:radius="2dp" />
                </shape>
            </item>
        </layer-list>
    </item>

    <!-- Pressed State -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#005bb5" /> <!-- Darker blue -->
            <corners android:radius="4dp" />
        </shape>
    </item>

    <!-- Default State: Solid Blue -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/ps4_blue" />
            <corners android:radius="4dp" />
        </shape>
    </item>
</selector>

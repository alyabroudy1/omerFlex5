<?xml version="1.0" encoding="utf-8"?>
<!-- PS4-Style Home Screen Layout with 3 Columns -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:descendantFocusability="afterDescendants">

    <com.omarflex6.ui.custom.FlowBackgroundView
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Top System Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="48dp"
            android:paddingTop="24dp"
            android:paddingBottom="12dp"
            android:gravity="end|center_vertical">

            <TextClock
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:format12Hour="h:mm a"
                android:textColor="#E0E0E0"
                android:textSize="18sp"
                android:fontFamily="sans-serif-medium"
                android:shadowColor="#80000000"
                android:shadowDx="1"
                android:shadowDy="1"
                android:shadowRadius="2" />
        </LinearLayout>

    <!-- Main 3-Column Content -->
    <LinearLayout
        android:id="@+id/main_content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <!-- COLUMN 1: Categories Sidebar (70% height, centered, rounded) -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/sidebar_wrapper"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.12">

            <!-- Centered sidebar with rounded corners, 75% height -->
            <LinearLayout
                android:id="@+id/sidebar_container"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:orientation="vertical"
                android:background="@drawable/bg_ps4_sidebar"
                android:paddingVertical="16dp"
                android:paddingHorizontal="8dp"
                android:elevation="8dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHeight_percent="0.75"
                app:layout_constraintWidth_percent="0.9">

                <!-- App Logo/Title -->
                <TextView
                    android:id="@+id/text_app_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="OMARFLIX"
                    android:textColor="@color/ps4_blue"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:layout_marginBottom="12dp" />

                <!-- Categories RecyclerView (Vertical, Scrollable) -->
                <com.omarflex6.ui.view.NavigableRecyclerView
                    android:id="@+id/recycler_categories"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:clipToPadding="false"
                    android:descendantFocusability="afterDescendants"
                    android:focusable="true"
                    android:nextFocusRight="@id/recycler_movies"
                    android:orientation="vertical"
                    android:overScrollMode="never"
                    android:scrollbars="none"
                    android:paddingVertical="4dp"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    tools:listitem="@layout/item_category_ps4" />

                <!-- Search Button at bottom -->
                <ImageButton
                    android:id="@+id/btn_search"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/selector_ps4_category"
                    android:contentDescription="Search"
                    android:src="@drawable/ic_search"
                    android:focusable="true"
                    android:nextFocusRight="@id/recycler_movies"
                    android:padding="8dp"
                    app:tint="@color/ps4_text_primary" />

            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Divider -->
        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="@android:color/transparent" />

        <!-- COLUMN 2: Movies List (Single Column, Vertical Scroll) -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.25">

            <com.omarflex6.ui.view.NavigableRecyclerView
                android:id="@+id/recycler_movies"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:descendantFocusability="afterDescendants"
                android:focusable="true"
                android:nextFocusLeft="@id/recycler_categories"
                android:nextFocusRight="@id/hero_container"
                android:orientation="vertical"
                android:overScrollMode="never"
                android:scrollbars="none"
                android:padding="16dp"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:listitem="@layout/item_movie_card_ps4" />

            <!-- Top fade gradient -->
            <View
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_gravity="top"
                android:background="@drawable/gradient_player_top" />

            <!-- Bottom fade gradient -->
            <View
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_gravity="bottom"
                android:background="@drawable/gradient_player_bottom" />

        </FrameLayout>

        <!-- Divider -->
        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="@android:color/transparent" />

        <!-- COLUMN 3: Hero Section (Trailer + Info) -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/hero_container"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.60"
            android:focusable="true"
            android:focusableInTouchMode="false"
            android:descendantFocusability="afterDescendants">

            <!-- Background Image -->
            <ImageView
                android:id="@+id/image_hero_background"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                tools:src="@color/ps4_card_bg" />

            <!-- ExoPlayer View for Trailer -->
            <androidx.media3.ui.PlayerView
                android:id="@+id/player_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:use_controller="false"
                app:resize_mode="zoom"
                app:shutter_background_color="@android:color/transparent"
                app:surface_type="texture_view" />

            <!-- WebView for YouTube embed playback -->
            <WebView
                android:id="@+id/youtube_webview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone" />

            <!-- YouTube Controls Overlay (hidden by default) -->
            <include
                layout="@layout/youtube_controls_overlay"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <!-- Gradient Overlay for text readability -->
            <View
                android:id="@+id/gradient_overlay"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/gradient_ps4_hero_overlay" />

            <!-- Hero Content Container -->
            <LinearLayout
                android:id="@+id/hero_info_container"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="32dp"
                android:layout_marginEnd="32dp"
                android:layout_marginBottom="32dp"
                android:orientation="vertical"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintWidth_percent="0.7"
                app:layout_constraintHorizontal_bias="0">

                <!-- Movie Title -->
                <TextView
                    android:id="@+id/text_hero_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/white"
                    android:textSize="32sp"
                    android:textStyle="bold"
                    android:shadowColor="#000000"
                    android:shadowDx="2"
                    android:shadowDy="2"
                    android:shadowRadius="4"
                    android:maxLines="2"
                    android:ellipsize="end"
                    tools:text="Stranger Things" />

                <!-- Movie Description -->
                <TextView
                    android:id="@+id/text_hero_description"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:ellipsize="end"
                    android:maxLines="4"
                    android:textColor="@color/ps4_text_secondary"
                    android:textSize="14sp"
                    android:lineSpacingMultiplier="1.3"
                    tools:text="When a young boy vanishes, a small town uncovers a mystery involving secret experiments, terrifying supernatural forces and one strange little girl." />

                <!-- Action Buttons Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <!-- Watch Now Button -->
                    <Button
                        android:id="@+id/btn_watch_now"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:text="Watch Now"
                        android:textColor="@color/white"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:paddingHorizontal="24dp"
                        android:background="@drawable/selector_ps4_button"
                        app:backgroundTint="@null"
                        android:focusable="true"
                        android:nextFocusLeft="@id/recycler_movies"
                        android:nextFocusRight="@id/btn_mute"
                        android:nextFocusUp="@id/btn_watch_now"
                        android:nextFocusDown="@id/btn_watch_now" />

                </LinearLayout>

            </LinearLayout>

            <!-- Control Icons (Bottom Right) -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="32dp"
                android:layout_marginEnd="32dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <!-- Mute Button -->
                <ImageButton
                    android:id="@+id/btn_mute"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="12dp"
                    android:background="@drawable/selector_ps4_category"
                    android:contentDescription="Toggle mute"
                    android:src="@drawable/ic_volume_on"
                    android:focusable="true"
                    android:nextFocusLeft="@id/btn_watch_now"
                    android:nextFocusRight="@id/btn_fullscreen"
                    android:padding="12dp"
                    app:tint="@color/ps4_text_primary" />

                <!-- Fullscreen Button -->
                <ImageButton
                    android:id="@+id/btn_fullscreen"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/selector_ps4_category"
                    android:contentDescription="Toggle fullscreen"
                    android:src="@drawable/ic_fullscreen"
                    android:focusable="true"
                    android:nextFocusLeft="@id/btn_mute"
                    android:nextFocusRight="@id/btn_fullscreen"
                    android:padding="12dp"
                    app:tint="@color/ps4_text_primary" />
            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </LinearLayout>
    </LinearLayout>

    <!-- Loading Overlay -->
    <FrameLayout
        android:id="@+id/loading_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/ps4_background"
        android:visibility="visible"
        android:elevation="10dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center">

            <ProgressBar
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:indeterminateTint="@color/ps4_blue"
                android:layout_marginBottom="24dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Loading..."
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

    </FrameLayout>

    <!-- Error View -->
    <LinearLayout
        android:id="@+id/error_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/ps4_background"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone"
        android:elevation="10dp">

        <ImageView
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:src="@drawable/ic_no_wifi"
            android:layout_marginBottom="24dp"
            app:tint="@color/ps4_blue" />

        <TextView
            android:id="@+id/text_error_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Connection Error"
            android:textColor="@android:color/white"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/text_error_message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Check your internet connection and try again"
            android:textColor="@color/ps4_text_secondary"
            android:textSize="16sp"
            android:textAlignment="center"
            android:layout_marginBottom="32dp" />

        <Button
            android:id="@+id/btn_retry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Retry"
            android:textColor="@android:color/white"
            android:backgroundTint="@color/ps4_blue"
            android:paddingStart="48dp"
            android:paddingEnd="48dp"
            android:textSize="18sp"
            android:textStyle="bold" />

    </LinearLayout>

</FrameLayout>

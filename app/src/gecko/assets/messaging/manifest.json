{
    "manifest_version": 2,
    "name": "CookieExtractor",
    "version": "6.0",
    "description": "Extracts HttpOnly cookies and HTML content for GeckoView CF bypass",
    "permissions": [
        "cookies",
        "tabs",
        "nativeMessaging",
        "nativeMessagingFromContent",
        "geckoViewAddons",
        "<all_urls>"
    ],
    "background": {
        "scripts": [
            "background.js"
        ]
    },
    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "content.js"
            ],
            "run_at": "document_start",
            "all_frames": true
        }
    ],
    "browser_specific_settings": {
        "gecko": {
            "id": "cookie_extractor@omarflex5.com"
        }
    }
}
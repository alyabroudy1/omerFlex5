<?xml version="1.0" encoding="utf-8"?>
<!-- PS4 style category/button selector -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    
    <!-- Focused state - blue glow background -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#330070D1" />
            <stroke android:width="2dp" android:color="#0070D1" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    
    <!-- Pressed state -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#550070D1" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    
    <!-- Selected state -->
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#220070D1" />
            <stroke android:width="1dp" android:color="#0070D1" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    
    <!-- Default state - transparent -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <corners android:radius="8dp" />
        </shape>
    </item>
</selector>
